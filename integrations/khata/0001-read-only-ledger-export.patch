Subject: [PATCH] Expose authenticated read-only ledger export for reviewed
 reconciliation

---
 backend/app/routers/api.py |  6 ++++++
 backend/tests/test_api.py  | 17 +++++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/backend/app/routers/api.py b/backend/app/routers/api.py
index 04f4868..183914f 100644
--- a/backend/app/routers/api.py
+++ b/backend/app/routers/api.py
@@ -65,6 +65,12 @@ class LedgerDoc(BaseModel):
     settings: dict = Field(default_factory=dict)
 
 
+@router.get("/ledger")
+def export_ledger(user: dict = Depends(current_user)):
+    """Read the caller's synced ledger without merging or changing it."""
+    return {"account_email": user["email"], "ledger": db.load_ledger(user["sub"]) or LedgerDoc().model_dump()}
+
+
 @router.post("/sync")
 def sync(body: LedgerDoc, user: dict = Depends(current_user)):
     try:
