@@ -207,3 +211,16 @@ async def test_verify_google_rejects_wrong_audience(monkeypatch):
     with pytest.raises(HTTPException) as exc:
         await auth.verify_google_credential("token-value")
     assert exc.value.status_code == 401
+
+
+def test_read_only_ledger_export_is_authenticated_and_user_scoped(client):
+    from app import db
+    assert client.get('/api/ledger').status_code==401
+    headers={'Authorization':'Bearer '+create_session('suite-export','export@example.com')}
+    ledger={'customers':[{'id':'C1','name':'Customer'}],'transactions':[], 'bills':[], 'settings':{}}
+    db.save_ledger('suite-export','export@example.com',ledger)
+    response=client.get('/api/ledger',headers=headers)
+    assert response.json()=={'account_email':'export@example.com','ledger':ledger}
+    assert db.load_ledger('suite-export')==ledger
+    other={'Authorization':'Bearer '+create_session('suite-other','other@example.com')}
+    assert client.get('/api/ledger',headers=other).json()['ledger']['customers']==[]
