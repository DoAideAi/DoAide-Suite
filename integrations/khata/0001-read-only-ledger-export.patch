@@ -45,6 +46,9 @@ def test_sitemap_is_xml_with_all_routes(client):
         "https://khata.doaide.com/guides/upi-payments-for-kirana-shops",
         "https://khata.doaide.com/guides/gst-bill-format-for-small-shops",
