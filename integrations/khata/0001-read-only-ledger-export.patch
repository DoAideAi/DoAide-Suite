index dbc4563..ab4cea6 100644
--- a/backend/tests/test_api.py
+++ b/backend/tests/test_api.py
@@ -34,6 +34,7 @@ def test_sitemap_is_xml_with_all_routes(client):
         "https://khata.doaide.com/",
