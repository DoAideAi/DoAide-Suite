diff --git a/scripts/migrate_suite_handoffs.py b/scripts/migrate_suite_handoffs.py
new file mode 100644
index 0000000..761ea2b
--- /dev/null
+++ b/scripts/migrate_suite_handoffs.py
@@ -0,0 +1,38 @@
+"""Add the Suite handoff table to an initialized Invoicer database.
+
+This additive migration deliberately does not rewrite legacy Alembic history.
+It requires the existing users/invoices tables and refuses incompatible schemas.
+Run against an explicitly configured test DATABASE_URL before production rollout.
+"""
+import json
+from pathlib import Path
+import sys
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from sqlalchemy import inspect
+import app.models  # register referenced models before resolving foreign keys
+from app.core.database import engine
+from app.models.suite_handoff import SuiteHandoff
+
+
+def migrate(target):
+    with target.begin() as connection:
+        inspector=inspect(connection)
+        if not all(inspector.has_table(name) for name in ('users','invoices')):
+            raise ValueError('Initialize the existing Invoicer schema before applying this additive migration')
+        existed=inspector.has_table('suite_handoffs')
+        SuiteHandoff.__table__.create(connection,checkfirst=True)
+        inspector=inspect(connection)
+        columns={column['name']:column for column in inspector.get_columns('suite_handoffs')}
+        expected={column.name for column in SuiteHandoff.__table__.columns}
+        if set(columns)!=expected or not columns['invoice_id']['nullable']:
+            raise ValueError('Existing suite_handoffs columns are incompatible; review the schema before proceeding')
+        unique={tuple(value['column_names']) for value in inspector.get_unique_constraints('suite_handoffs')}
+        if not {('user_id','idempotency_key'),('user_id','document_id')}<=unique:
+            raise ValueError('Suite handoff uniqueness constraints are missing')
+        keys=inspector.get_foreign_keys('suite_handoffs')
+        if not any(key['constrained_columns']==['invoice_id'] and key['referred_table']=='invoices' and key.get('options',{}).get('ondelete','').upper()=='SET NULL' for key in keys):
+            raise ValueError('Invoice deletion must retain a Suite handoff tombstone')
+    return {'migration':'suite-handoffs-v1','created':not existed,'verified':True}
+
+
+if __name__=='__main__':print(json.dumps(migrate(engine),indent=2))
diff --git a/tests/test_suite_handoff.py b/tests/test_suite_handoff.py
new file mode 100644
index 0000000..f2831e1
--- /dev/null
+++ b/tests/test_suite_handoff.py
@@ -0,0 +1,77 @@
+import hashlib
+import json
+from copy import deepcopy
+from decimal import Decimal
+import pytest
+from sqlalchemy import select
+from app.models.invoice import Invoice
+from app.models.suite_handoff import SuiteHandoff
+from app.services.usage_service import get_current_month_usage
+
+
+def draft(product='scope', total=123456):
+    snapshot={'record':{'id':'source-record','product':product,'title':'Approved work'},'payload':{'client':'Example Client'},'extra':{'total_paise':total}}
+    checksum=hashlib.sha256(json.dumps(snapshot,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
+    return {'source':'doaide-'+product,'document':{'id':'source-document','record_id':'source-record','kind':'draft-invoice','number':'DRAFT-123','snapshot':snapshot,'checksum':checksum}}
+
+
+@pytest.mark.parametrize('product',['scope','amc','orderdesk'])
+def test_draft_is_exact_owned_idempotent_and_counted_once(auth_client,db_session,product):
+    body=draft(product);headers={'Idempotency-Key':'suite-job-123'}
+    response=auth_client.post('/api/v1/invoices/drafts',json=body,headers=headers)
+    assert response.status_code==201,response.text
+    identifier=int(response.json()['invoice_id']);invoice=db_session.get(Invoice,identifier)
+    assert invoice.total==Decimal('1234.56') and invoice.status=='draft' and invoice.buyer_name=='Example Client'
+    assert invoice.cgst is None and invoice.sgst is None and invoice.igst is None
+    assert get_current_month_usage(db_session,invoice.user_id)==1
+    for key in ('suite-job-123','another-retry-key'):
+        replay=auth_client.post('/api/v1/invoices/drafts',json=body,headers={'Idempotency-Key':key})
+        assert replay.status_code==201 and replay.json()['invoice_id']==str(identifier)
+    assert len(db_session.scalars(select(SuiteHandoff)).all())==1
+    assert get_current_month_usage(db_session,invoice.user_id)==1
+    conflict=auth_client.post('/api/v1/invoices/drafts',json=draft(product,99),headers=headers)
+    assert conflict.status_code==409
+
+
+def test_draft_rejects_forgery_malformed_and_unauthenticated(client,auth_client):
+    headers={'Idempotency-Key':'suite-job-123'}
+    body=draft();body['document']['snapshot']['extra']['total_paise']=1
+    assert auth_client.post('/api/v1/invoices/drafts',json=body,headers=headers).status_code==422
+    body=draft();body['document']['snapshot']['record']=[]
+    assert auth_client.post('/api/v1/invoices/drafts',json=body,headers=headers).status_code==422
+    auth_client.headers.pop('Authorization')
+    assert auth_client.post('/api/v1/invoices/drafts',json=draft(),headers=headers).status_code==401
+
+
+def test_source_ids_are_account_scoped(auth_client,db_session):
+    headers={'Idempotency-Key':'same-job-reference'};body=draft()
+    first=auth_client.post('/api/v1/invoices/drafts',json=body,headers=headers).json()['invoice_id']
+    response=auth_client.post('/api/v1/auth/register',json={'phone':'+919820012346','password':'another-secret-password','name':'Other','email':'other@example.test'})
+    assert response.status_code==201
+    auth_client.headers['Authorization']='Bearer '+response.json()['access_token']
+    second=auth_client.post('/api/v1/invoices/drafts',json=body,headers=headers)
+    assert second.status_code==201 and second.json()['invoice_id']!=first
+    assert auth_client.get('/api/v1/invoices/'+first).status_code==404
+    assert auth_client.get('/api/v1/invoices/'+first+'/suite-source').status_code==404
+
+
+def test_retry_retains_final_status_and_does_not_resurrect_deleted_draft(auth_client,db_session):
+    body=draft();headers={'Idempotency-Key':'source-draft-retry'}
+    identifier=auth_client.post('/api/v1/invoices/drafts',json=body,headers=headers).json()['invoice_id']
+    assert auth_client.get('/api/v1/invoices/'+identifier+'/suite-source').json()==body
+    assert auth_client.patch('/api/v1/invoices/'+identifier+'/approve').status_code==200
+    assert auth_client.post('/api/v1/invoices/drafts',json=body,headers=headers).json()['status']=='approved'
+    assert auth_client.delete('/api/v1/invoices/'+identifier).status_code==204
+    assert auth_client.post('/api/v1/invoices/drafts',json=body,headers=headers).status_code==410
+    assert not db_session.scalars(select(Invoice)).all()
+
+
+def test_additive_migration_preserves_existing_invoice_and_is_repeatable(auth_client,db_session):
+    from scripts.migrate_suite_handoffs import migrate
+    body=draft();headers={'Idempotency-Key':'migration-fixture'}
+    identifier=auth_client.post('/api/v1/invoices/drafts',json=body,headers=headers).json()['invoice_id']
+    engine=db_session.get_bind();db_session.commit()
+    SuiteHandoff.__table__.drop(engine)
+    assert migrate(engine)=={'migration':'suite-handoffs-v1','created':True,'verified':True}
+    assert migrate(engine)=={'migration':'suite-handoffs-v1','created':False,'verified':True}
+    assert db_session.get(Invoice,int(identifier)).total==Decimal('1234.56')
