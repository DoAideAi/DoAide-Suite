+from sqlalchemy import ForeignKey, String, Text, UniqueConstraint
+from sqlalchemy.orm import Mapped, mapped_column
+from app.core.database import Base
+from app.models.mixins import TimestampMixin
+
+
+class SuiteHandoff(Base, TimestampMixin):
+    __tablename__ = 'suite_handoffs'
+    __table_args__ = (UniqueConstraint('user_id','idempotency_key'), UniqueConstraint('user_id','document_id'))
+    id: Mapped[int] = mapped_column(primary_key=True)
+    user_id: Mapped[int] = mapped_column(ForeignKey('users.id',ondelete='CASCADE'),nullable=False)
+    invoice_id: Mapped[int | None] = mapped_column(ForeignKey('invoices.id',ondelete='SET NULL'),nullable=True)
+    idempotency_key: Mapped[str] = mapped_column(String(128),nullable=False)
+    document_id: Mapped[str] = mapped_column(String(100),nullable=False)
+    request_hash: Mapped[str] = mapped_column(String(64),nullable=False)
+    source: Mapped[str] = mapped_column(String(30),nullable=False)
+    snapshot: Mapped[str] = mapped_column(Text,nullable=False)
diff --git a/app/routers/suite_handoff.py b/app/routers/suite_handoff.py
new file mode 100644
index 0000000..853e4bf
--- /dev/null
+++ b/app/routers/suite_handoff.py
@@ -0,0 +1,78 @@
+"""Authenticated, idempotent drafts from immutable DoAide Suite documents."""
+import hashlib
+import json
+from decimal import Decimal
+from typing import Literal
+from fastapi import APIRouter, Depends, Header, HTTPException
+from pydantic import BaseModel, ConfigDict
+from sqlalchemy import or_, select
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import Session
+from app.core.database import get_db
+from app.core.deps import get_current_user
+from app.models.invoice import Invoice
+from app.models.invoice_item import InvoiceItem
+from app.models.suite_handoff import SuiteHandoff
+from app.models.user import User
+from app.services.usage_service import check_quota, increment_usage
+
+router=APIRouter(prefix='/invoices',tags=['suite integrations'])
+
+
+class Draft(BaseModel):
+    model_config=ConfigDict(extra='forbid')
+    source:Literal['doaide-scope','doaide-amc','doaide-orderdesk']
+    document:dict
+
+
+def canonical(value):return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False)
+
+
+@router.post('/drafts',status_code=201)
+def create_draft(body:Draft,idempotency_key:str=Header(min_length=8,max_length=128),current_user:User=Depends(get_current_user),db:Session=Depends(get_db)):
+    doc=body.document;snap=doc.get('snapshot')
+    if not isinstance(snap,dict) or doc.get('kind')!='draft-invoice':raise HTTPException(422,'Supply an immutable draft-invoice document')
+    if len(canonical(doc))>500000:raise HTTPException(413,'Draft document is too large')
+    checksum=hashlib.sha256(canonical(snap).encode()).hexdigest()
+    record=snap.get('record',{})
+    if not isinstance(record,dict) or not isinstance(snap.get('extra',{}),dict) or not isinstance(snap.get('payload',{}),dict):raise HTTPException(422,'Invalid source document structure')
+    if checksum!=doc.get('checksum') or record.get('product')!=body.source.removeprefix('doaide-') or record.get('id')!=doc.get('record_id'):raise HTTPException(422,'Source checksum or product identity does not match')
+    identifier=doc.get('id');number=doc.get('number')
+    if not isinstance(identifier,str) or not 1<=len(identifier)<=100 or not isinstance(number,str) or not 1<=len(number)<=100:raise HTTPException(422,'Invalid source document identifier')
+    extra=snap.get('extra',{});commercial=extra.get('commercial',{})
+    if not isinstance(commercial,dict):raise HTTPException(422,'Invalid commercial summary')
+    total=extra.get('total_paise',commercial.get('total_paise'))
+    if type(total) is not int or not 0<=total<=100_000_000_000:raise HTTPException(422,'Source document must state its total in integer paise')
+    fingerprint=hashlib.sha256(canonical(body.model_dump()).encode()).hexdigest()
+
+    def existing():
+        rows=db.scalars(select(SuiteHandoff).where(SuiteHandoff.user_id==current_user.id,or_(SuiteHandoff.idempotency_key==idempotency_key,SuiteHandoff.document_id==identifier))).all()
+        if not rows:return None
+        if any(row.request_hash!=fingerprint or row.document_id!=identifier for row in rows):raise HTTPException(409,'Handoff reference was already used for different source content')
+        invoice=db.get(Invoice,rows[0].invoice_id) if rows[0].invoice_id is not None else None
+        if not invoice:raise HTTPException(410,'The source draft was deliberately deleted; a retry cannot recreate it')
+        return {'invoice_id':str(invoice.id),'source_document':identifier,'status':invoice.status}
+
+    prior=existing()
+    if prior:return prior
+    allowed,used,limit=check_quota(db,current_user.id,current_user.plan)
+    if not allowed:raise HTTPException(429,f'Monthly invoice quota exceeded ({used}/{limit})')
+    payload=snap.get('payload',{});buyer=str(payload.get('client') or payload.get('customer') or '')[:255]
+    invoice=Invoice(user_id=current_user.id,status='draft',source='doaide-suite',image_path='',buyer_name=buyer,invoice_number=number,total=Decimal(total)/100,ocr_raw_text=None)
+    db.add(invoice);db.flush()
+    db.add(InvoiceItem(invoice_id=invoice.id,description=str(record.get('title') or number)[:20000],quantity=1,total=Decimal(total)/100))
+    db.add(SuiteHandoff(user_id=current_user.id,invoice_id=invoice.id,idempotency_key=idempotency_key,document_id=identifier,request_hash=fingerprint,source=body.source,snapshot=canonical(doc)))
+    try:
+        db.flush();increment_usage(db,current_user.id);db.commit()
+    except IntegrityError:
+        db.rollback();prior=existing()
+        if prior:return prior
+        raise HTTPException(409,'Concurrent handoff conflict; retry with the same key')
+    return {'invoice_id':str(invoice.id),'source_document':identifier,'status':'draft'}
+
+
+@router.get('/{invoice_id}/suite-source')
+def source_document(invoice_id:int,current_user:User=Depends(get_current_user),db:Session=Depends(get_db)):
+    row=db.scalar(select(SuiteHandoff).where(SuiteHandoff.invoice_id==invoice_id,SuiteHandoff.user_id==current_user.id))
+    if not row:raise HTTPException(404,'Suite source not found')
+    return {'source':row.source,'document':json.loads(row.snapshot)}
