+def test_concurrent_reservations_use_one_authoritative_balance(tmp_path):
+    engine=create_engine('sqlite:///'+str(tmp_path/'race.db'),connect_args={'check_same_thread':False,'timeout':10})
+    Base.metadata.create_all(engine)
+    with Session(engine) as db:
+        business=Business(name='Race');db.add(business);db.flush()
+        product=Product(business_id=business.id,sku='RACE',name='Race');warehouse=Warehouse(business_id=business.id,name='Main');db.add_all([product,warehouse]);db.flush()
+        db.add(StockLevel(business_id=business.id,product_id=product.id,warehouse_id=warehouse.id,quantity=10))
+        ids=(business.id,product.id,warehouse.id);db.commit()
+    barrier=Barrier(2)
+    def run(index):
+        with Session(engine) as db:
+            body=Reservation(reference='race-'+str(index),expires_at=datetime.now(timezone.utc)+timedelta(hours=1),lines=[{'product_id':ids[1],'warehouse_id':ids[2],'quantity':7}])
+            barrier.wait()
+            try:reserve(body,SimpleNamespace(business_id=ids[0]),db);return 200
+            except HTTPException as exc:db.rollback();return exc.status_code
+    with ThreadPoolExecutor(2) as pool:assert sorted(pool.map(run,[1,2]))==[200,409]
+    with Session(engine) as db:assert db.query(SuiteReservation).count()==1
+
