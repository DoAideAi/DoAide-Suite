diff --git a/backend/app/routers/suite.py b/backend/app/routers/suite.py
new file mode 100644
index 0000000..c190d20
--- /dev/null
+++ b/backend/app/routers/suite.py
@@ -0,0 +1,132 @@
+"""Authenticated, retry-safe stock commands. This API sends no notifications."""
+import hashlib
+import json
+from decimal import Decimal
+from datetime import datetime, timedelta, timezone
+from typing import Literal
+from fastapi import APIRouter, Depends, HTTPException, Query, Header
+from pydantic import BaseModel, ConfigDict, Field, AwareDatetime
+from sqlalchemy.orm import Session
+from app.core.database import get_db
+from app.core.deps import get_current_business, require_staff
+from app.models.user import User
+from app.models.product import Product
+from app.models.stock_level import StockLevel
+from app.models.suite_reservation import SuiteReservation
+from app.services.reservations import lock_stock, held, check_refs
+
+def expected_business(expected: int | None = Header(None, alias='X-DoAide-Business-ID'), user: User = Depends(get_current_business)):
+    if expected is not None and expected != user.business_id:
+        raise HTTPException(403, 'Connection credential belongs to a different business')
+
+
+router = APIRouter(prefix='/suite', tags=['suite'], dependencies=[Depends(expected_business)])
+
+
+class Line(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    product_id: int = Field(gt=0)
+    warehouse_id: int = Field(gt=0)
+    quantity: int = Field(gt=0, le=1000000000, strict=True)
+    price: Decimal | None = Field(default=None, ge=0, max_digits=16, decimal_places=2)
+    tax: Decimal | None = Field(default=None, ge=0, le=100)
+    unit: str | None = Field(default=None, max_length=100)
+
+
+class Reservation(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    reference: str = Field(min_length=1, max_length=160, pattern=r'^[A-Za-z0-9:_-]+$')
+    lines: list[Line] = Field(min_length=1, max_length=200)
+    expires_at: AwareDatetime
+
+
+def result(row):
+    status = row.status
+    if status == 'reserved' and datetime.fromisoformat(row.expires_at) <= datetime.now(timezone.utc):
+        status = 'expired'
+    return {'business_id': row.business_id, 'reference': row.reference, 'reservation_id': row.id, 'status': status,
+            'lines': row.lines, 'expires_at': row.expires_at}
+
+
+@router.get('/stock')
+def stock(warehouse_id: int = Query(gt=0), skip: int = Query(0, ge=0),
+          limit: int = Query(200, ge=1, le=200), user: User = Depends(get_current_business), db: Session = Depends(get_db)):
+    rows = db.query(StockLevel, Product).join(Product, Product.id == StockLevel.product_id).filter(
+        StockLevel.business_id == user.business_id, Product.business_id == user.business_id,
+        StockLevel.warehouse_id == warehouse_id, Product.deleted_at.is_(None), Product.is_active.is_(True)
+    ).order_by(StockLevel.id).offset(skip).limit(limit).all()
+    return [{'business_id': user.business_id, 'product_id': p.id, 'warehouse_id': s.warehouse_id, 'sku': p.sku, 'name': p.name,
+             'unit': p.unit, 'price': str(p.selling_price or 0), 'tax': str(p.tax_rate or 0),
+             'quantity': s.quantity, 'held': held(db, user.business_id, p.id, s.warehouse_id)} for s, p in rows]
+
+
+@router.post('/reservations', dependencies=[Depends(require_staff)])
+def reserve(body: Reservation, user: User = Depends(get_current_business), db: Session = Depends(get_db)):
+    lock_stock(db, user.business_id)
+    lines = sorted([x.model_dump(mode='json',exclude_none=True) for x in body.lines], key=lambda x: (x['product_id'], x['warehouse_id']))
+    if len({(x['product_id'], x['warehouse_id']) for x in lines}) != len(lines):
+        raise HTTPException(422, 'Aggregate duplicate product/warehouse lines')
+    expiry = body.expires_at.astimezone(timezone.utc).isoformat()
+    fingerprint = hashlib.sha256(json.dumps({'lines': lines, 'expires_at': expiry}, sort_keys=True).encode()).hexdigest()
+    prior = db.query(SuiteReservation).filter_by(business_id=user.business_id, reference=body.reference).first()
+    if prior:
+        if prior.fingerprint != fingerprint:
+            raise HTTPException(409, 'Reservation reference was already used with different contents')
+        db.commit()
+        return result(prior)
+    if not datetime.now(timezone.utc) < body.expires_at <= datetime.now(timezone.utc) + timedelta(days=7):
+        raise HTTPException(422, 'Reservation must expire within seven days')
+    for line in lines:
+        check_refs(db, user.business_id, line['product_id'], line['warehouse_id'])
+        product = db.get(Product, line['product_id'])
+        if ('price' in line and Decimal(line['price']) != (product.selling_price or 0)) or ('tax' in line and Decimal(line['tax']) != (product.tax_rate or 0)) or ('unit' in line and line['unit'] != product.unit):
+            raise HTTPException(409, 'Catalogue changed; refresh prices and reconfirm the order')
+        stock = db.query(StockLevel).filter_by(business_id=user.business_id,
+            product_id=line['product_id'], warehouse_id=line['warehouse_id']).first()
+        if not stock or stock.quantity - held(db, user.business_id, line['product_id'], line['warehouse_id']) < line['quantity']:
+            raise HTTPException(409, 'Insufficient available stock')
+    row = SuiteReservation(business_id=user.business_id, reference=body.reference, fingerprint=fingerprint,
+                           lines=lines, expires_at=expiry, status='reserved')
+    db.add(row)
+    db.commit()
+    return result(row)
+
+
+@router.get('/reservations/{reference}')
+def lookup(reference: str, user: User = Depends(get_current_business), db: Session = Depends(get_db)):
+    row = db.query(SuiteReservation).filter_by(business_id=user.business_id, reference=reference).first()
+    if not row:
+        raise HTTPException(404, 'Reservation not found')
+    return result(row)
+
+
+@router.post('/reservations/{reference}/{command}', dependencies=[Depends(require_staff)])
+def transition(reference: str, command: Literal['dispatch', 'cancel', 'reconcile'],
+               user: User = Depends(get_current_business), db: Session = Depends(get_db)):
+    lock_stock(db, user.business_id)
+    row = db.query(SuiteReservation).filter_by(business_id=user.business_id, reference=reference).first()
+    if command == 'reconcile':
+        if not row:
+            if len(reference)>160 or not __import__('re').fullmatch(r'[A-Za-z0-9:_-]+',reference):raise HTTPException(422,'Invalid reference')
+            row=SuiteReservation(business_id=user.business_id,reference=reference,fingerprint='missing',lines=[],status='missing',expires_at=datetime.now(timezone.utc).isoformat())
+            db.add(row)
+        db.commit()
+        return result(row)
+    if not row:
+        raise HTTPException(404, 'Reservation not found')
+    target = 'dispatched' if command == 'dispatch' else 'cancelled'
+    if row.status == target or command == 'cancel' and row.status == 'expired':
+        db.commit()
+        return result(row)
+    if row.status != 'reserved':
+        raise HTTPException(409, 'Reservation is ' + row.status)
+    if command == 'dispatch':
+        for line in row.lines:
+            stock = db.query(StockLevel).filter_by(business_id=user.business_id,
+                product_id=line['product_id'], warehouse_id=line['warehouse_id']).first()
+            if not stock or stock.quantity < line['quantity']:
+                raise HTTPException(409, 'Stock is inconsistent; reconcile Inventory')
+            stock.quantity -= line['quantity']
+    row.status = target
+    db.commit()
+    return result(row)
diff --git a/backend/app/services/reservations.py b/backend/app/services/reservations.py
new file mode 100644
index 0000000..69236c5
--- /dev/null
+++ b/backend/app/services/reservations.py
@@ -0,0 +1,42 @@
+"""Inventory is authoritative. All stock writers share the business transaction lock."""
+from datetime import datetime, timezone
+from fastapi import HTTPException
+from sqlalchemy import update
+from app.models.business import Business
+from app.models.suite_reservation import SuiteReservation
+from app.models.product import Product
+from app.models.warehouse import Warehouse
+
+
+def timestamp():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def lock_stock(db, business_id):
+    # An UPDATE acquires a write lock on SQLite and a row lock on PostgreSQL.
+    # Unlike SELECT FOR UPDATE it also serializes SQLite writers.
+    db.execute(update(Business).where(Business.id == business_id).values(id=Business.id))
+    db.expire_all()
+    db.query(SuiteReservation).filter(SuiteReservation.business_id == business_id,
+        SuiteReservation.status == 'reserved', SuiteReservation.expires_at <= timestamp()).update(
+            {'status': 'expired'}, synchronize_session=False)
+    db.flush()
+
+
+def held(db, business_id, product_id, warehouse_id):
+    rows = db.query(SuiteReservation).filter(SuiteReservation.business_id == business_id,
+        SuiteReservation.status == 'reserved', SuiteReservation.expires_at > timestamp()).all()
+    return sum(line['quantity'] for row in rows for line in row.lines
+               if line['product_id'] == product_id and line['warehouse_id'] == warehouse_id)
+
+
+def check_quantity(db, stock, quantity):
+    if quantity < held(db, stock.business_id, stock.product_id, stock.warehouse_id) or quantity < 0:
+        raise HTTPException(409, 'Insufficient unreserved stock; release reservations first')
+
+
+def check_refs(db, business_id, product_id, warehouse_id):
+    product = db.query(Product).filter_by(id=product_id, business_id=business_id, deleted_at=None, is_active=True).first()
+    warehouse = db.query(Warehouse).filter_by(id=warehouse_id, business_id=business_id, deleted_at=None).first()
+    if not product or not warehouse:
+        raise HTTPException(404, 'Product or warehouse not found in this business')
diff --git a/backend/scripts/migrate_suite.py b/backend/scripts/migrate_suite.py
new file mode 100644
index 0000000..34fd427
--- /dev/null
+++ b/backend/scripts/migrate_suite.py
@@ -0,0 +1,34 @@
+"""Add only the Suite authority table; preserve the initialized service schema."""
+import json
+import os
+from pathlib import Path
+import sys
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from sqlalchemy import inspect
+import app.models
+from app.core.database import engine
+from app.models.suite_reservation import SuiteReservation
+
+
+def migrate(target):
+    table=SuiteReservation.__table__
+    with target.begin() as connection:
+        inspector=inspect(connection)
+        if not all(inspector.has_table(name) for name in ('businesses', 'stock_levels')):
+            raise ValueError('Initialize the existing Inventory schema first')
+        existed=inspector.has_table(table.name)
+        table.create(connection,checkfirst=True)
+        inspector=inspect(connection)
+        columns={value['name']:value for value in inspector.get_columns(table.name)}
+        if set(columns)!={column.name for column in table.columns}:
+            raise ValueError('Existing Suite authority table is incompatible')
+        unique={tuple(value['column_names']) for value in inspector.get_unique_constraints(table.name)}
+        if ('business_id','reference') not in unique:
+            raise ValueError('Business/reference uniqueness is missing')
+    return {'migration':table.name+'-v1','created':not existed,'verified':True}
+
+
+if __name__=='__main__':
+    if not os.environ.get('DATABASE_URL'):
+        raise SystemExit('Set DATABASE_URL explicitly to the intended test/deployment database')
+    print(json.dumps(migrate(engine),indent=2))
