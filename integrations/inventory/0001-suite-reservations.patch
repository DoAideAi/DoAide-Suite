@@ -0,0 +1,126 @@
+from datetime import datetime, timedelta, timezone
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+from types import SimpleNamespace
+import pytest
+from fastapi import HTTPException
+from sqlalchemy import create_engine
+from sqlalchemy.orm import Session
+from app.core.database import Base
+from app.models.business import Business
+from app.models.product import Product
+from app.models.warehouse import Warehouse
+from app.models.stock_level import StockLevel
+from app.models.suite_reservation import SuiteReservation
+from app.routers.suite import reserve, Reservation
+
+
+def setup(c, quantity=10):
+    p = c.post('/products', json={'sku':'TEA','name':'Tea','selling_price':100,'unit':'piece'}).json()
+    w = c.post('/warehouses', json={'name':'Main'}).json()
+    stock = c.post('/stock',json={'product_id':p['id'],'warehouse_id':w['id'],'quantity':quantity}).json()
+    return stock, {'reference':'suite-order-1','expires_at':(datetime.now(timezone.utc)+timedelta(hours=1)).isoformat(),
+        'lines':[{'product_id':p['id'],'warehouse_id':w['id'],'quantity':7}]}
+
+
+def test_retry_dispatch_once_and_changed_reference_rejected(auth_client):
+    c=auth_client;s,b=setup(c)
+    a=c.post('/suite/reservations',json=b)
+    assert a.status_code==200,a.text
+    assert c.post('/suite/reservations',json=b).json()==a.json()
+    assert c.get('/stock').json()[0]['quantity']==10
+    assert c.get('/suite/stock',params={'warehouse_id':s['warehouse_id']}).json()[0]['held']==7
+    assert c.post('/suite/reservations',json={**b,'lines':[{**b['lines'][0],'quantity':8}]}).status_code==409
+    assert c.post('/suite/reservations/suite-order-1/dispatch').json()['status']=='dispatched'
+    assert c.post('/suite/reservations/suite-order-1/dispatch').json()['status']=='dispatched'
+    assert c.get('/stock').json()[0]['quantity']==3
+    assert c.post('/suite/reservations',json=b).json()['status']=='dispatched'
+    assert c.post('/suite/reservations/suite-order-1/cancel').status_code==409
+
+
+def test_reservation_blocks_native_count_adjustment_and_shipping(auth_client):
+    c=auth_client;s,b=setup(c)
+    assert c.post('/suite/reservations',json=b).status_code==200
+    assert c.patch('/stock/'+str(s['id']),json={'quantity':6}).status_code==409
+    # Rollback is handled by production get_db; test override retains the Session.
+    customer=c.post('/customers',json={'name':'Buyer'}).json()
+    order=c.post('/sales-orders',json={'customer_id':customer['id'],'warehouse_id':s['warehouse_id'],
+        'items':[{'product_id':s['product_id'],'quantity':5,'unit_price':100}]}).json()
