diff --git a/backend/tests/test_suite_lots.py b/backend/tests/test_suite_lots.py
new file mode 100644
index 0000000..5efd839
--- /dev/null
+++ b/backend/tests/test_suite_lots.py
@@ -0,0 +1,109 @@
+from datetime import date,timedelta
+from app.models.user import User,UserRole
+
+
+def fixture(c):
+    warehouse=c.post('/warehouses',json={'name':'Lots'}).json()['id']
+    lot={'lot':'L1','ingredient':'Tea','supplier':'Supplier','unit':'kg','quantity':'10.125','cost':'2.50','expiry':(date.today()+timedelta(days=365)).isoformat(),'quality':'Released','file_id':'evidence'}
+    counter=[0]
+    def command(action,data,*,batch='B1',status=200,reference=None):
+        counter[0]+=1
+        body={'reference':reference or 'command-'+str(counter[0]),'batch':batch,'warehouse_id':warehouse,'action':action,'data':data}
+        response=c.post('/suite/lots/commands',json=body)
+        assert response.status_code==status,response.text
+        return response.json()
+    command('receive_lots',{'lots':[lot]},reference='receipt')
+    return warehouse,lot,command
+
+
+def test_decimal_reserve_produce_return_release_dispatch_recall_and_retry(auth_client):
+    c=auth_client;w,lot,cmd=fixture(c)
+    usage=[{'lot':'L1','quantity':'2.125','waste':'.125','unit':'kg'}]
+    receipt=cmd('reserve_materials',{'usage':usage},reference='reserve')
+    assert receipt['after']['lot:L1']['held']=='2.125'
+    assert cmd('reserve_materials',{'usage':usage},reference='reserve')==receipt
+    cmd('reserve_materials',{'usage':[{**usage[0],'quantity':'9'}]},batch='B2',status=409)
+    output={'sku':'finished:B1','quantity':'8','expiry':lot['expiry'],'data':{'quality':'Quarantined','expiry':lot['expiry'],'record_id':'test'}}
+    result=cmd('produce',{'usage':usage,'output':output},reference='produce')
+    assert result['after']['lot:L1']['quantity']=='8.000' and result['after']['lot:L1']['held']=='0'
+    assert result['after']['finished:B1']['held']=='8'
+    cmd('dispatch_batch',{'quantity':1},status=409)
+    cmd('return_material',{'lot':'L1','quantity':'.5'})
+    cmd('return_material',{'lot':'L1','quantity':'2'},status=409)
+    cmd('quality_release',{})
+    result=cmd('dispatch_batch',{'quantity':3,'reference':'customer-order'},reference='dispatch')
+    assert result['after']['finished:B1']['quantity']=='5'
+    assert cmd('dispatch_batch',{'quantity':3,'reference':'customer-order'},reference='dispatch')==result
+    cmd('recall',{})
+    cmd('dispatch_batch',{'quantity':1},status=409)
+    assert cmd('dispose_output',{'quantity':5})['after']['finished:B1']['quantity']=='0'
+
+
+def test_lot_quality_corrections_and_missing_receipt_fence(auth_client):
+    c=auth_client;w,lot,cmd=fixture(c)
+    cmd('set_lot_quality',{'sku':'lot:L1','quality':'Quarantined'})
+    cmd('reserve_materials',{'usage':[{'lot':'L1','quantity':1,'unit':'kg'}]},status=409)
+    result=cmd('adjust_lot',{'sku':'lot:L1','expected_quantity':'10.125','quantity':'8.5'})
