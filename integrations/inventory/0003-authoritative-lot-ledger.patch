@@ -0,0 +1,34 @@
+from sqlalchemy import JSON, String, UniqueConstraint
+from sqlalchemy.orm import Mapped, mapped_column
+from app.core.database import Base
+from app.models.mixins import BusinessScopedMixin, TimestampMixin
+
+
+class SuiteLot(Base, BusinessScopedMixin, TimestampMixin):
+    __tablename__='suite_lots'
+    __table_args__=(UniqueConstraint('business_id','warehouse_id','sku',name='uq_suite_lot'),)
+    id: Mapped[int]=mapped_column(primary_key=True)
+    warehouse_id: Mapped[int]=mapped_column()
+    sku: Mapped[str]=mapped_column(String(240))
+    name: Mapped[str]=mapped_column(String(240))
+    unit: Mapped[str]=mapped_column(String(100))
+    quantity: Mapped[str]=mapped_column(String(60))
+    details: Mapped[dict]=mapped_column(JSON)
+
+
+class SuiteBatch(Base, BusinessScopedMixin, TimestampMixin):
+    __tablename__='suite_batches'
+    __table_args__=(UniqueConstraint('business_id','warehouse_id','reference',name='uq_suite_batch'),)
+    id: Mapped[int]=mapped_column(primary_key=True)
+    warehouse_id: Mapped[int]=mapped_column()
+    reference: Mapped[str]=mapped_column(String(160))
+    details: Mapped[dict]=mapped_column(JSON,default=dict)
+
+
+class SuiteLotCommand(Base, BusinessScopedMixin, TimestampMixin):
+    __tablename__='suite_lot_commands'
+    __table_args__=(UniqueConstraint('business_id','reference',name='uq_suite_lot_command'),)
+    id: Mapped[int]=mapped_column(primary_key=True)
+    reference: Mapped[str]=mapped_column(String(160))
+    fingerprint: Mapped[str]=mapped_column(String(64))
+    result: Mapped[dict]=mapped_column(JSON)
diff --git a/backend/app/routers/suite_lots.py b/backend/app/routers/suite_lots.py
new file mode 100644
index 0000000..c4649d7
--- /dev/null
+++ b/backend/app/routers/suite_lots.py
@@ -0,0 +1,203 @@
+"""Authoritative decimal lot ledger with atomic production and retained receipts."""
+from datetime import date
+from decimal import Decimal
+import hashlib
+import json
+from typing import Literal
+from fastapi import APIRouter, Depends, HTTPException, Query
+from pydantic import BaseModel, ConfigDict, Field
+from sqlalchemy.orm import Session
+from app.core.database import get_db
+from app.core.deps import get_current_business, require_staff
+from app.models.user import User, UserRole
+from app.models.warehouse import Warehouse
+from app.models.suite_lot import SuiteLot, SuiteBatch, SuiteLotCommand
+from app.services.reservations import lock_stock
+from app.routers.suite import expected_business
+
+router=APIRouter(prefix='/suite/lots',tags=['suite-lots'],dependencies=[Depends(expected_business),Depends(require_staff)])
+
+
+def fail(message):raise HTTPException(409,message)
+
+def quantity(value,positive=False):
+    try:result=Decimal(str(value))
+    except Exception:raise HTTPException(422,'Invalid decimal quantity')
+    if not result.is_finite() or result < 0 or result > Decimal('1000000000') or result.as_tuple().exponent < -6 or positive and result <= 0:
+        raise HTTPException(422,'Quantity must be positive/nonnegative with at most six decimal places')
+    return result
+
+
+def digest(data):return hashlib.sha256(json.dumps(data,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+
+
+def load(db,business,warehouse,sku):return db.query(SuiteLot).filter_by(business_id=business,warehouse_id=warehouse,sku=sku).first()
+
+
+def holds(db,business,warehouse,sku):
+    return sum((quantity(row.details.get('holds',{}).get(sku,0)) for row in db.query(SuiteBatch).filter_by(business_id=business,warehouse_id=warehouse)),Decimal(0))
+
+
+def snapshot(db,row):
+    d=row.details
+    held=quantity(row.quantity) if d['quality']!='Released' else holds(db,row.business_id,row.warehouse_id,row.sku)
+    return {'sku':row.sku,'name':row.name,'unit':row.unit,
+        'quantity':row.quantity,'held':str(held),'data':d}
+
+
+class Command(BaseModel):
+    model_config=ConfigDict(extra='forbid')
+    reference: str=Field(min_length=1,max_length=160,pattern=r'^[A-Za-z0-9:_-]+$')
+    batch: str=Field(min_length=1,max_length=160,pattern=r'^[A-Za-z0-9:_-]+$')
+    warehouse_id: int=Field(gt=0)
+    action: Literal['receive_lots','reserve_materials','release_materials','produce','return_material','quality_release','quality_reject','recall','dispose_output','dispatch_batch','set_lot_quality','adjust_lot']
+    data: dict
+
+
+def normalize_lines(lines):
+    if not isinstance(lines,list) or not 1<=len(lines)<=200:raise HTTPException(422,'Provide 1–200 lot lines')
+    totals={}
+    for line in lines:
+        if not isinstance(line,dict) or not isinstance(line.get('lot'),str) or not 1<=len(line['lot'])<=200:raise HTTPException(422,'Invalid lot reference')
+        if not isinstance(line.get('unit'),str) or not 1<=len(line['unit'])<=100:raise HTTPException(422,'A lot unit of at most 100 characters is required')
+        key='lot:'+line['lot'];q=quantity(line.get('quantity'),True)
+        totals[key]=totals.get(key,Decimal(0))+q
+    return totals
+
+
+@router.get('')
+def listing(warehouse_id:int=Query(gt=0),skip:int=Query(0,ge=0),limit:int=Query(200,ge=1,le=200),user:User=Depends(get_current_business),db:Session=Depends(get_db)):
+    rows=db.query(SuiteLot).filter_by(business_id=user.business_id,warehouse_id=warehouse_id).order_by(SuiteLot.id).offset(skip).limit(limit).all()
+    return {'business_id':user.business_id,'warehouse_id':warehouse_id,'balances':[snapshot(db,row) for row in rows]}
+
+
+@router.post('/commands')
+def execute(body:Command,user:User=Depends(get_current_business),db:Session=Depends(get_db)):
+    if len(json.dumps(body.data))>200000:raise HTTPException(422,'Command exceeds the lot ledger limit')
+    lock_stock(db,user.business_id)
+    prior=db.query(SuiteLotCommand).filter_by(business_id=user.business_id,reference=body.reference).first()
+    fingerprint=digest(body.model_dump())
+    if prior:
+        if prior.fingerprint!=fingerprint:fail('Command reference already used or reconciled; it cannot be reused')
+        return prior.result
+    wh=db.query(Warehouse).filter_by(id=body.warehouse_id,business_id=user.business_id,deleted_at=None).first()
+    if not wh:raise HTTPException(404,'Warehouse not found in this business')
+    if body.action in ('quality_release','quality_reject','recall','dispose_output','set_lot_quality','adjust_lot') and user.role not in (UserRole.OWNER,UserRole.MANAGER):
+        raise HTTPException(403,'Manager approval required for quality or stock corrections')
+    run=db.query(SuiteBatch).filter_by(business_id=user.business_id,warehouse_id=body.warehouse_id,reference=body.batch).first()
+    if not run:
+        run=SuiteBatch(business_id=user.business_id,warehouse_id=body.warehouse_id,reference=body.batch,details={});db.add(run);db.flush()
+    state=dict(run.details);d=body.data;a=body.action;before={};touched=set()
+    def read(sku,required=True):
+        if sku not in touched:
+            row=load(db,user.business_id,body.warehouse_id,sku)
+            before[sku]=snapshot(db,row) if row else None;touched.add(sku)
+        row=load(db,user.business_id,body.warehouse_id,sku)
+        if required and not row:fail('Receive the lot first: '+sku)
+        return row
+    def usable(row):
+        if row.details['quality']!='Released' or row.details.get('expiry','0000')<date.today().isoformat():fail('Lot is quarantined or expired')
+    if a=='receive_lots':
+        lines=d.get('lots',[]);normalize_lines(lines)
+        for lot in lines:
+            if lot.get('quality') not in ('Released','Quarantined') or not all(isinstance(lot.get(k),str) and lot[k] for k in ('ingredient','supplier','unit','expiry')):raise HTTPException(422,'Lot identity, quality, units and expiry are required')
+            try:expiry=date.fromisoformat(lot['expiry'])
+            except ValueError:raise HTTPException(422,'Invalid lot expiry')
+            quantity(lot.get('cost'));q=quantity(lot['quantity'],True)
+            if lot['quality']=='Released' and expiry<date.today():fail('Expired lot cannot be released')
+            sku='lot:'+lot['lot'];row=read(sku,False)
+            if row:
+                if row.details!=lot:fail('Lot reference already has different receiving details')
+            else:db.add(SuiteLot(business_id=user.business_id,warehouse_id=body.warehouse_id,sku=sku,name=lot['ingredient'],unit=lot['unit'],quantity=str(q),details=lot));db.flush()
+    elif a=='reserve_materials':
+        if state.get('holds') or state.get('production'):fail('This batch already reserved or consumed inputs')
+        totals=normalize_lines(d.get('usage'));new={}
+        for sku,q in totals.items():
+            row=read(sku);usable(row)
+            if quantity(row.quantity)-holds(db,user.business_id,body.warehouse_id,sku)<q:fail('Insufficient unreserved lot: '+sku)
+            if any(x.get('unit','').casefold()!=row.details['unit'].casefold() for x in d['usage'] if 'lot:'+x['lot']==sku):fail('Lot units must match')
+            new[sku]=str(q)
+        state['holds']=new
+    elif a=='release_materials':
+        if not state.get('holds') or state.get('production'):fail('No unconsumed reservations exist')
+        for sku in state['holds']:read(sku)
+        state.pop('holds')
+    elif a=='produce':
+        if state.get('production'):fail('This batch already consumed stock')
+        totals=normalize_lines(d.get('usage'));output=d.get('output',{})
+        if not isinstance(output,dict) or not isinstance(output.get('data'),dict):raise HTTPException(422,'Finished output metadata is required')
+        units=quantity(output.get('quantity'),True)
+        if not isinstance(output.get('sku'),str) or not output['sku'].startswith('finished:') or len(output['sku'])>240:raise HTTPException(422,'Invalid finished batch reference')
+        if read(output['sku'],False):fail('Finished batch already exists')
+        try:expiry=date.fromisoformat(output['expiry'])
+        except (ValueError,KeyError,TypeError):raise HTTPException(422,'Invalid finished expiry')
+        if expiry<date.today():fail('Finished batch is expired')
+        for sku,q in totals.items():
+            row=read(sku);usable(row);own=quantity(state.get('holds',{}).get(sku,0))
+            if quantity(row.quantity)-holds(db,user.business_id,body.warehouse_id,sku)+own<q:fail('Insufficient available lot: '+sku)
+            lines=[x for x in d['usage'] if 'lot:'+x['lot']==sku]
+            if any(x.get('unit','').casefold()!=row.details['unit'].casefold() or quantity(x.get('waste',0))>quantity(x['quantity']) for x in lines):fail('Invalid units or waste')
+            row.quantity=str(quantity(row.quantity)-q)
+        # Any unused portion of this batch's holds is released atomically.
+        for sku in state.get('holds',{}):read(sku)
+        state.pop('holds',None);state['production']={'inputs':d['usage'],'output':output,'returns':{}}
+        db.add(SuiteLot(business_id=user.business_id,warehouse_id=body.warehouse_id,sku=output['sku'],name=str(output.get('name','Batch output'))[:240],unit='unit',quantity=str(units),details=output['data']));db.flush()
+        if output['data'].get('quality')!='Quarantined' or output['data'].get('expiry')!=output['expiry']:raise HTTPException(422,'Produced output must begin quarantined with its expiry')
+    elif a=='return_material':
+        production=state.get('production')
+        if not production:fail('No production to return')
+        sku='lot:'+str(d.get('lot'));q=quantity(d.get('quantity'),True);row=read(sku)
+        allowed=sum((quantity(x['quantity'])-quantity(x.get('waste',0)) for x in production['inputs'] if 'lot:'+x['lot']==sku),Decimal(0))
+        returns=dict(production['returns']);previous=quantity(returns.get(sku,0))
+        if previous+q>allowed:fail('Return exceeds original non-waste consumption')
+        row.quantity=str(quantity(quantity(row.quantity)+q));returns[sku]=str(previous+q)
+        state['production']={**production,'returns':returns}
+    elif a in ('set_lot_quality','adjust_lot'):
+        sku=str(d.get('sku'));row=read(sku)
+        if not sku.startswith('lot:'):fail('Choose an ingredient lot')
+        if a=='set_lot_quality':
+            if holds(db,user.business_id,body.warehouse_id,sku):fail('Release batch reservations before changing lot quality')
+            quality=d.get('quality')
+            if quality not in ('Released','Quarantined'):raise HTTPException(422,'Invalid lot quality')
+            if quality=='Released' and row.details['expiry']<date.today().isoformat():fail('Expired lot cannot be released')
+            row.details={**row.details,'quality':quality}
+        else:
+            q=quantity(d.get('quantity'))
+            if quantity(d.get('expected_quantity'))!=quantity(row.quantity):fail('Stock changed; refresh before correcting')
+            if q<holds(db,user.business_id,body.warehouse_id,sku):fail('Correction cannot consume reserved stock')
+            row.quantity=str(q)
+    else:
+        production=state.get('production')
+        if not production:fail('Record production first')
+        row=read(production['output']['sku']);quality=row.details['quality'];q=quantity(row.quantity)
+        if a in ('quality_release','quality_reject'):
+            if quality!='Quarantined':fail('Quality decision was already made')
+            if a=='quality_release' and row.details['expiry']<date.today().isoformat():fail('Expired output cannot be released')
+            row.details={**row.details,'quality':'Released' if a=='quality_release' else 'Rejected'}
+        elif a=='recall':row.details={**row.details,'quality':'Recalled'}
+        elif a=='dispose_output':
+            if quality not in ('Rejected','Recalled'):fail('Only rejected or recalled output can be disposed')
+            used=quantity(d.get('quantity'),True)
+            if used>q:fail('Disposal exceeds quarantined output')
+            row.quantity=str(q-used)
+        elif a=='dispatch_batch':
+            usable(row);used=quantity(d.get('quantity'),True)
+            if used>q:fail('Dispatch exceeds released output')
+            row.quantity=str(q-used)
+            state['dispatches']=[*state.get('dispatches',[]),d]
+    run.details=state;db.flush()
+    result={'business_id':user.business_id,'warehouse_id':body.warehouse_id,'reference':body.reference,'batch':body.batch,'action':a,'status':'committed',
+        'before':before,'after':{sku:snapshot(db,load(db,user.business_id,body.warehouse_id,sku)) for sku in sorted(touched)}}
+    db.add(SuiteLotCommand(business_id=user.business_id,reference=body.reference,fingerprint=fingerprint,result=result));db.commit()
+    return result
+
+
+@router.post('/commands/{reference}/reconcile')
+def reconcile(reference:str,user:User=Depends(get_current_business),db:Session=Depends(get_db)):
+    if len(reference)>160 or not __import__('re').fullmatch(r'[A-Za-z0-9:_-]+',reference):raise HTTPException(422,'Invalid command reference')
+    lock_stock(db,user.business_id)
+    row=db.query(SuiteLotCommand).filter_by(business_id=user.business_id,reference=reference).first()
+    if not row:
+        row=SuiteLotCommand(business_id=user.business_id,reference=reference,fingerprint='missing',result={'business_id':user.business_id,'reference':reference,'status':'missing'})
+        db.add(row);db.commit()
+    return row.result
