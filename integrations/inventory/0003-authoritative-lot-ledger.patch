+def test_concurrent_batches_cannot_reserve_the_same_decimal_stock(tmp_path):
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+    from types import SimpleNamespace
+    from sqlalchemy import create_engine
+    from sqlalchemy.orm import Session
+    from fastapi import HTTPException
+    from app.core.database import Base
+    from app.models.business import Business
+    from app.models.warehouse import Warehouse
+    from app.models.suite_lot import SuiteLot,SuiteBatch
+    from app.routers.suite_lots import execute,Command
+    engine=create_engine('sqlite:///'+str(tmp_path/'lot-race.db'),connect_args={'check_same_thread':False,'timeout':10})
+    Base.metadata.create_all(engine)
+    with Session(engine) as db:
+        business=Business(name='Race');db.add(business);db.flush()
+        warehouse=Warehouse(name='Main',business_id=business.id);db.add(warehouse);db.flush()
+        db.add(SuiteLot(business_id=business.id,warehouse_id=warehouse.id,sku='lot:ONE',name='Flour',unit='kg',quantity='1.125',details={'quality':'Released','expiry':(date.today()+timedelta(days=10)).isoformat(),'unit':'kg'}))
+        ids=(business.id,warehouse.id);db.commit()
+    barrier=Barrier(2)
+    def run(index):
+        with Session(engine) as db:
+            body=Command(reference='R'+str(index),batch='B'+str(index),warehouse_id=ids[1],action='reserve_materials',data={'usage':[{'lot':'ONE','quantity':'.75','unit':'kg'}]})
+            barrier.wait()
+            try:execute(body,SimpleNamespace(business_id=ids[0],role=UserRole.OWNER),db);return 200
+            except HTTPException as exc:db.rollback();return exc.status_code
+    with ThreadPoolExecutor(2) as pool:assert sorted(pool.map(run,[1,2]))==[200,409]
+    with Session(engine) as db:assert db.query(SuiteBatch).count()==1
