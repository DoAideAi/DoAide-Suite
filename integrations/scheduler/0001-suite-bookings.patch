+from datetime import datetime, timedelta, timezone
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+from fastapi import HTTPException
+from sqlalchemy import create_engine
+from sqlalchemy.orm import Session
+from app.core.database import Base
+from app.models.booking import Booking
+from app.models.suite_booking import SuiteBooking
+from app.models.business import Business
+from app.models.user import User
+from app.models.meeting_type import MeetingType
+from app.models.availability_rule import AvailabilityRule
+from app.routers.suite import create, Appointment
+
+
+def setup(c,h):
+    mt=c.post('/api/v1/meeting-types/',headers=h,json={'name':'Visit','duration_minutes':30,'buffer_after_minutes':15}).json()
+    start=(datetime.now(timezone.utc)+timedelta(days=2)).replace(hour=10,minute=0,second=0,microsecond=0)
+    r=c.post('/api/v1/availability/',headers=h,json={'day_of_week':start.weekday(),'start_time':'09:00','end_time':'17:00'})
+    assert r.status_code==201,r.text
+    return {'reference':'suite-visit-1','meeting_type_id':mt['id'],'host_email':'test@example.com',
+        'guest_name':'Customer','guest_email':'customer@example.com','start_time':start.isoformat(),'end_time':(start+timedelta(minutes=30)).isoformat()}
+
+
+def test_retry_and_native_conflict(client,auth_headers,db_session,monkeypatch):
+    b=setup(client,auth_headers)
+    def forbidden(**kwargs):raise AssertionError('Suite must not send notifications')
+    monkeypatch.setattr('app.routers.bookings.send_booking_confirmation',forbidden)
+    r=client.post('/api/v1/suite/bookings',headers=auth_headers,json=b)
+    assert r.status_code==200,r.text
+    assert client.post('/api/v1/suite/bookings',headers=auth_headers,json=b).json()==r.json()
+    assert 'cancel_token' not in r.json() and not r.json()['notifications_sent']
