diff --git a/backend/app/routers/suite.py b/backend/app/routers/suite.py
new file mode 100644
index 0000000..6bb28d4
--- /dev/null
+++ b/backend/app/routers/suite.py
@@ -0,0 +1,152 @@
+"""Suite commands commit here; they never send email or expose guest access tokens."""
+import hashlib
+import json
+from datetime import timedelta
+from typing import Literal
+from fastapi import APIRouter, Depends, HTTPException, Header
+from pydantic import BaseModel, ConfigDict, Field, AwareDatetime, EmailStr
+from sqlalchemy.orm import Session
+from app.core.database import get_db
+from app.core.deps import get_current_user
+from app.models.booking import Booking, BookingStatus
+from app.models.business import Business
+from app.models.meeting_type import MeetingType
+from app.models.user import User, UserRole
+from app.models.suite_booking import SuiteBooking
+from app.services.booking_guard import lock_calendar, check_slot, utc
+from app.services.usage import check_limit, increment_usage
+
+def expected_business(expected: int | None = Header(None, alias='X-DoAide-Business-ID'), user: User = Depends(get_current_user)):
+    if expected is not None and expected != user.business_id:
+        raise HTTPException(403, 'Connection credential belongs to a different business')
+
+
+router = APIRouter(prefix='/suite/bookings', tags=['suite'], dependencies=[Depends(expected_business)])
+
+
+class Appointment(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    reference: str = Field(min_length=1, max_length=160, pattern=r'^[A-Za-z0-9:_-]+$')
+    meeting_type_id: int = Field(gt=0)
+    host_email: EmailStr
+    start_time: AwareDatetime
+    end_time: AwareDatetime
+    guest_name: str = Field(min_length=1, max_length=255)
+    guest_email: EmailStr
+
+
+class Change(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    command: Literal['cancel', 'reschedule', 'reconcile']
+    start_time: AwareDatetime | None = None
+    end_time: AwareDatetime | None = None
+
+
+def authorized(user, db):
+    business = db.get(Business, user.business_id)
+    if not business or not business.is_active or user.role not in (UserRole.OWNER, UserRole.ADMIN):
+        raise HTTPException(403, 'Active business owner or administrator required')
+
+
+def fingerprint(body):
+    return hashlib.sha256(json.dumps(body.model_dump(mode='json'), sort_keys=True).encode()).hexdigest()
+
+
+def find(db, user, reference):
+    row = db.query(SuiteBooking).filter_by(business_id=user.business_id, reference=reference).first()
+    if not row:
+        raise HTTPException(404, 'Booking reference not found')
+    if row.booking_id is None and row.fingerprint != 'missing':
+        raise HTTPException(410, 'Booking was deleted; this reference cannot be reused')
+    return row
+
+
+def result(db, row):
+    if row.booking_id is None and row.fingerprint=='missing':
+        return {'business_id':row.business_id,'reference':row.reference,'status':'missing'}
+    if row.booking_id is None:
+        raise HTTPException(410, 'Booking was deleted; this reference cannot be reused')
+    booking = db.get(Booking, row.booking_id)
+    host = db.get(User, booking.host_user_id)
+    return {'business_id': row.business_id, 'reference': row.reference, 'booking_id': booking.id, 'status': booking.status.value,
+            'host_email': host.email, 'start_time': utc(booking.start_time).isoformat(),
+            'end_time': utc(booking.end_time).isoformat(), 'notifications_sent': False}
+
+
+@router.get('/{reference}')
+def lookup(reference: str, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    authorized(user, db)
+    return result(db, find(db, user, reference))
+
+
+@router.post('')
+def create(body: Appointment, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    authorized(user, db)
+    lock_calendar(db, user.business_id)
+    prior = db.query(SuiteBooking).filter_by(business_id=user.business_id, reference=body.reference).first()
+    if prior:
+        if prior.fingerprint != fingerprint(body):
+            raise HTTPException(409, 'Reference already used with different contents')
+        return result(db, prior)
+    host = db.query(User).filter_by(email=str(body.host_email).lower(), business_id=user.business_id, is_active=True).first()
+    mt = db.query(MeetingType).filter_by(id=body.meeting_type_id, business_id=user.business_id, is_active=True).first()
+    if not host or not mt:
+        raise HTTPException(404, 'Active host or meeting type not found in this business')
+    if body.end_time - body.start_time != timedelta(minutes=mt.duration_minutes):
+        raise HTTPException(422, 'Appointment duration must equal the meeting type duration')
+    check_slot(db, mt, host, body.start_time, body.end_time, require_availability=True)
+    business = db.get(Business, user.business_id)
+    if not check_limit(db, user.business_id, business.plan)[0]:
+        raise HTTPException(429, 'Monthly meeting limit reached')
+    booking = Booking(business_id=user.business_id, meeting_type_id=mt.id, host_user_id=host.id,
+        guest_name=body.guest_name, guest_email=str(body.guest_email), guest_timezone='UTC',
+        start_time=utc(body.start_time), end_time=utc(body.end_time),
+        status=BookingStatus.PENDING if mt.requires_confirmation else BookingStatus.CONFIRMED,
+        notes='DoAide Suite reference: ' + body.reference)
+    db.add(booking)
+    db.flush()
+    row = SuiteBooking(business_id=user.business_id, reference=body.reference, fingerprint=fingerprint(body), booking_id=booking.id)
+    db.add(row)
+    increment_usage(db, user.business_id)
+    db.commit()
+    return result(db, row)
+
+
+@router.post('/{reference}')
+def change(reference: str, body: Change, idempotency_key: str = Header(min_length=1, max_length=160),
+           user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    authorized(user, db)
+    lock_calendar(db, user.business_id)
+    if body.command == 'reconcile':
+        row=db.query(SuiteBooking).filter_by(business_id=user.business_id,reference=reference).first()
+        if not row:
+            if len(reference)>160 or not __import__('re').fullmatch(r'[A-Za-z0-9:_-]+',reference):raise HTTPException(422,'Invalid reference')
+            row=SuiteBooking(business_id=user.business_id,reference=reference,fingerprint='missing',booking_id=None,commands={})
+            db.add(row)
+        db.commit()
+        return result(db,row)
+    row = find(db, user, reference)
+    if row.booking_id is None:raise HTTPException(410,'Reconciled reference cannot be reused')
+    previous = row.commands.get(idempotency_key)
+    if previous:
+        if previous != fingerprint(body):
+            raise HTTPException(409, 'Command key already used with different contents')
+        return result(db, row)
+    booking = db.get(Booking, row.booking_id)
+    if body.command == 'cancel':
+        if booking.status in (BookingStatus.COMPLETED, BookingStatus.NO_SHOW):
+            raise HTTPException(409, 'Completed appointment cannot be cancelled')
+        booking.status = BookingStatus.CANCELLED
+    else:
+        if booking.status not in (BookingStatus.CONFIRMED, BookingStatus.PENDING, BookingStatus.RESCHEDULED):
+            raise HTTPException(409, 'Closed appointment cannot be rescheduled')
+        mt = db.get(MeetingType, booking.meeting_type_id)
+        host = db.get(User, booking.host_user_id)
+        if not body.start_time or not body.end_time or body.end_time - body.start_time != timedelta(minutes=mt.duration_minutes):
+            raise HTTPException(422, 'Provide the start and end with the meeting type duration')
+        check_slot(db, mt, host, body.start_time, body.end_time, exclude=booking.id, require_availability=True)
+        booking.start_time, booking.end_time = utc(body.start_time), utc(body.end_time)
+        booking.status = BookingStatus.PENDING if mt.requires_confirmation else BookingStatus.RESCHEDULED
+    row.commands = {**row.commands, idempotency_key: fingerprint(body)}
+    db.commit()
+    return result(db, row)
diff --git a/backend/app/services/booking_guard.py b/backend/app/services/booking_guard.py
new file mode 100644
index 0000000..7e5e018
--- /dev/null
+++ b/backend/app/services/booking_guard.py
@@ -0,0 +1,53 @@
+"""Serialize appointment changes across native and Suite entry points."""
+from datetime import datetime, timedelta, timezone
+from zoneinfo import ZoneInfo
+from fastapi import HTTPException
+from sqlalchemy import select, update
+from app.models.business import Business
+from app.models.booking import Booking, BookingStatus
+from app.models.meeting_type import MeetingType
+from app.models.availability_rule import AvailabilityRule
+
+ACTIVE = (BookingStatus.CONFIRMED, BookingStatus.PENDING, BookingStatus.RESCHEDULED)
+
+
+def utc(value):
+    # Historical native routes accepted naive UTC datetimes.
+    return value.replace(tzinfo=timezone.utc) if value.tzinfo is None else value.astimezone(timezone.utc)
+
+
+def lock_calendar(db, business_id):
+    db.execute(update(Business).where(Business.id == business_id).values(id=Business.id))
+    db.expire_all()
+
+
+def check_slot(db, mt, host, start, end, exclude=None, require_availability=False):
+    start, end = utc(start), utc(end)
+    if start >= end:
+        raise HTTPException(422, 'Booking must end after it starts')
+    rows = db.execute(select(Booking).where(Booking.business_id == host.business_id,
+        Booking.host_user_id == host.id, Booking.status.in_(ACTIVE))).scalars().all()
+    count = 0
+    local_start = start.astimezone(ZoneInfo(host.timezone))
+    for row in rows:
+        if row.id == exclude:
+            continue
+        previous = db.get(MeetingType, row.meeting_type_id)
+        before = previous.buffer_before_minutes if previous else 0
+        after = previous.buffer_after_minutes if previous else 0
+        if start - timedelta(minutes=mt.buffer_before_minutes) < utc(row.end_time) + timedelta(minutes=after) and end + timedelta(minutes=mt.buffer_after_minutes) > utc(row.start_time) - timedelta(minutes=before):
+            raise HTTPException(409, 'Host already has an appointment during this time or buffer')
+        if utc(row.start_time).astimezone(ZoneInfo(host.timezone)).date() == local_start.date():
+            count += 1
+    if mt.max_per_day and count >= mt.max_per_day:
+        raise HTTPException(409, 'Daily appointment limit reached')
+    if require_availability:
+        if start <= datetime.now(timezone.utc):
+            raise HTTPException(422, 'Appointment must start in the future')
+        local_end = end.astimezone(ZoneInfo(host.timezone))
+        rules = db.execute(select(AvailabilityRule).where(AvailabilityRule.business_id == host.business_id,
+            AvailabilityRule.user_id == host.id, AvailabilityRule.day_of_week == local_start.weekday(),
+            AvailabilityRule.is_active.is_(True))).scalars().all()
+        if local_start.date() != local_end.date() or not any(
+            rule.start_time <= local_start.strftime('%H:%M') and local_end.strftime('%H:%M:%S') <= rule.end_time + ':00' for rule in rules):
+            raise HTTPException(409, 'Requested time is outside the host availability rules')
