diff --git a/backend/scripts/migrate_suite.py b/backend/scripts/migrate_suite.py
new file mode 100644
index 0000000..98fd518
--- /dev/null
+++ b/backend/scripts/migrate_suite.py
@@ -0,0 +1,37 @@
+"""Add only the Suite authority table; preserve the initialized service schema."""
+import json
+import os
+from pathlib import Path
+import sys
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from sqlalchemy import inspect
+import app.models
+from app.core.database import engine
+from app.models.suite_booking import SuiteBooking
+
+
+def migrate(target):
+    table=SuiteBooking.__table__
+    with target.begin() as connection:
+        inspector=inspect(connection)
+        if not all(inspector.has_table(name) for name in ('businesses', 'bookings')):
+            raise ValueError('Initialize the existing Scheduler schema first')
+        existed=inspector.has_table(table.name)
+        table.create(connection,checkfirst=True)
+        inspector=inspect(connection)
+        columns={value['name']:value for value in inspector.get_columns(table.name)}
+        if set(columns)!={column.name for column in table.columns}:
+            raise ValueError('Existing Suite authority table is incompatible')
+        unique={tuple(value['column_names']) for value in inspector.get_unique_constraints(table.name)}
+        if ('business_id','reference') not in unique:
+            raise ValueError('Business/reference uniqueness is missing')
+        keys=inspector.get_foreign_keys(table.name)
+        if not columns['booking_id']['nullable'] or not any(key['constrained_columns']==['booking_id'] and key.get('options',{}).get('ondelete','').upper()=='SET NULL' for key in keys):
+            raise ValueError('Booking deletion must retain a reference tombstone')
+    return {'migration':table.name+'-v1','created':not existed,'verified':True}
+
+
+if __name__=='__main__':
+    if not os.environ.get('DATABASE_URL'):
+        raise SystemExit('Set DATABASE_URL explicitly to the intended test/deployment database')
+    print(json.dumps(migrate(engine),indent=2))
