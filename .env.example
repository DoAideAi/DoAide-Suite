# Local SQLite database; keep this directory private and backed up.
DOAIDE_DB_PATH=var/doaide.db
# Disabled by default. Enabling this permits queued real delivery through configured providers.
DOAIDE_DELIVERY_MODE=disabled
# Set these only on the server. Never prefix secrets with VITE_ or expose them in the browser.
DOAIDE_SMTP_HOST=
DOAIDE_SMTP_PORT=587
DOAIDE_SMTP_TLS=true
DOAIDE_SMTP_FROM=
DOAIDE_SMTP_USER=
DOAIDE_SMTP_PASSWORD=
# Use Razorpay test credentials for integration validation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional organization-owned invoice bridge. Must implement the documented idempotent contract.
DOAIDE_INVOICE_ADAPTER_URL=
DOAIDE_INVOICE_ADAPTER_TOKEN=
# Prefer explicit workspace mappings. URLs include the full draft endpoint for
# Invoicer, and the /api prefix for Contracts. Tokens are server-side JWTs.
# JSON shape: {"workspace-id":{"url":"https://service.example/api","token":"..."}}
DOAIDE_INVOICE_CONNECTIONS={}
DOAIDE_CONTRACTS_CONNECTIONS={}
# Optional speech-to-text. Each recording also requires consent in the UI.
DOAIDE_GROQ_TRANSCRIPTION_KEY=
# Signed inbound WhatsApp orders; publish the workspace catalogue first.
DOAIDE_META_APP_SECRET=
DOAIDE_META_VERIFY_TOKEN=
DOAIDE_META_ACCESS_TOKEN=
DOAIDE_META_GRAPH_VERSION=
# JSON shape: {"phone-number-id":{"workspace_id":"...","owner_id":"..."}}
DOAIDE_WHATSAPP_CHANNELS={}
# Require ClamAV for every new upload in a pilot; keep definitions updated.
DOAIDE_REQUIRE_MALWARE_SCAN=false
# 0 keeps files until an explicit policy is configured. Retention purge is a separate command.
DOAIDE_FILE_RETENTION_DAYS=0
# Enable only after testing SMTP and configuring the public HTTPS application URL.
DOAIDE_REQUIRE_VERIFIED_EMAIL=false
DOAIDE_PUBLIC_URL=http://127.0.0.1:8012
# Local keeps all products available without a subscription. Only stripe-test is also supported.
DOAIDE_BILLING_MODE=local
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Configure the JSON catalogue and base-plan key before selecting stripe-test. See OPERATIONS.md.
DOAIDE_BILLING_BASE_PLAN=
DOAIDE_BILLING_PLANS=
# Readiness can require a recent worker heartbeat or an unexpired active job lease.
DOAIDE_REQUIRE_WORKER=false
# Shared per-client-IP counters; only trust forwarding from your reverse proxy.
DOAIDE_API_REQUESTS_PER_MINUTE=600
DOAIDE_PUBLIC_REQUESTS_PER_MINUTE=120

# Authoritative OrderDesk stock and AMC appointments. Explicit activation is recorded per workspace.
# Inventory URL is the service root; Scheduler URL includes /api/v1. No secrets go in the repository.
# Business ID is checked by the service before committing. Warehouse IDs cannot change after activation.
DOAIDE_INVENTORY_CONNECTIONS={}
DOAIDE_SCHEDULER_CONNECTIONS={}
# Example mapping value: {"url":"https://inventory.example","token":"<private>","business_id":1,"warehouse_id":1}
# Scheduler mapping value: {"url":"https://scheduler.example/api/v1","token":"<private>","business_id":1}
