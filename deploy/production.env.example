# Install outside Git with mode 0600. These defaults permit a closed pilot only.
DOAIDE_ENVIRONMENT=production
DOAIDE_PUBLIC_URL=https://suite.example.com
DOAIDE_DB_PATH=/data/doaide.db
DOAIDE_REQUIRE_WORKER=true
DOAIDE_REQUIRE_MALWARE_SCAN=true
DOAIDE_CLAMD_SOCKET=/run/clamav/clamd.sock
# Replace with the exact source IP/CIDR of your trusted reverse proxy as seen by
# the app container. Never use '*'. Include loopback only for health checks.
FORWARDED_ALLOW_IPS=127.0.0.1
DOAIDE_DELIVERY_MODE=disabled
DOAIDE_REQUIRE_VERIFIED_EMAIL=false
DOAIDE_REGISTRATION_MODE=closed
DOAIDE_BILLING_MODE=local
DOAIDE_FILE_RETENTION_DAYS=0
